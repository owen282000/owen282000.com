# owen282000.com behind a Cloudflare Tunnel. Plain HTTP inside the Docker network:
# Cloudflare terminates TLS, cloudflared reaches this server at http://web:8080.
{
	auto_https off
	admin off
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The site has no JavaScript (JSON-LD blocks are data, not scripts) and loads nothing
		# from anywhere else. Inline styles are allowed: the screenshots set their aspect ratio
		# inline and the iPhone privacy page carries its own style block. Without scripts that
		# opens nothing worth worrying about.
		Content-Security-Policy "default-src 'self'; script-src 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

:8080 {
	root * /srv
	encode zstd gzip

	import security_headers

	# Images and the stylesheet change rarely; pages are short-lived so a deploy shows quickly.
	@assets path *.css *.webp *.png *.svg *.ico
	header @assets Cache-Control "public, max-age=604800"
	# Search engines show a large preview of an image straight from this server, in a page of
	# theirs, which same-origin would block. Pages stay same-origin.
	header @assets Cross-Origin-Resource-Policy "cross-origin"
	@pages not path *.css *.webp *.png *.svg *.ico
	header @pages Cache-Control "public, max-age=600"
	header @pages Cross-Origin-Resource-Policy "same-origin"

	@txt path *.txt
	header @txt Content-Type "text/plain; charset=utf-8"

	# Assistants and search results sometimes give a guide without its /life-dashboard/ folder.
	# The file matcher sits in its own route so that it runs after the regexp has set the slug,
	# and it keeps this to pages that exist.
	@top path_regexp top ^/([a-z0-9-]+)/?$
	route @top {
		@guide file /life-dashboard/{re.top.1}/index.html
		redir @guide /life-dashboard/{re.top.1}/ permanent
	}
	# A link copied out of Markdown or a sentence can bring the closing bracket or full stop.
	@punctuated path_regexp punctuated ^(/life-dashboard/[a-z0-9/-]*/)[).,]+$
	redir @punctuated {re.punctuated.1} permanent
	# The addresses people guess for a product's contact details, which are in the page's footer.
	@guessed path_regexp guessed ^/life-dashboard/(android|ios)/(about|about-us|contact|contact-us|contactus|help|support)/?$
	redir @guessed /life-dashboard/{re.guessed.1}/ permanent

	file_server

	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			import security_headers
			header Cross-Origin-Resource-Policy "same-origin"
			rewrite * /404.html
			file_server
		}
	}
}
